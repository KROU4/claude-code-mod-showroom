    "$.fs.list",
    "$.fs.read",
    "$.fs.write",
    "$.process.run",
    "$.session.cwd",
    "$.session.id",
    "$.state.get",
    "$.state.set",
    "$.tool.register",
    "$.ui.close",
    "$.ui.invalidate",
